# 三家各自的 Key；生图只使用 Grsai，不使用 OPENAI_API_KEY。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 可切换为国内节点 https://grsai.dakka.com.cn
GRSAI_BASE_URL=https://grsaiapi.com
GRSAI_API_KEY=
# 具体 GPT Image 型号留待选择，按 Grsai 文档/账号实际支持填写。
GRSAI_IMAGE_MODEL=gpt-image-2.6

FYDMAI_BASE_URL=https://fydmai.com
FYDMAI_API_KEY=
# 从该账号 GET /v1/models 返回的列表选择，不自动选用付费模型。
FYDMAI_VIDEO_MODEL=c7-wan3
